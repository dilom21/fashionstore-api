# Copy to .env only on EC2; never commit actual .env. Configure secrets via manager.
DATABASE_URL=postgresql+psycopg://RESTRICTED_API_LOGIN:REPLACE@db.example:5432/postgres?sslmode=require
DATABASE_BOOTSTRAP_URL=postgresql+psycopg://RESTRICTED_BOOTSTRAP_LOGIN:REPLACE@db.example:5432/postgres?sslmode=require
DATABASE_PLATFORM_URL=postgresql+psycopg://RESTRICTED_PLATFORM_LOGIN:REPLACE@db.example:5432/postgres?sslmode=require
DATABASE_WEBHOOK_URL=postgresql+psycopg://RESTRICTED_WEBHOOK_LOGIN:REPLACE@db.example:5432/postgres?sslmode=require
SECRET_KEY=REPLACE_WITH_PRIVATE_LONG_RANDOM_SECRET
SAAS_AUTH_ENABLED=true
SAAS_SUPERADMIN_ENABLED=true
SAAS_SUPERADMIN_EMAIL=REPLACE_QA_ADMIN_EMAIL
SAAS_SUPERADMIN_PASSWORD_HASH=REPLACE_ARGON2_HASH
SAAS_SUPERADMIN_KEY_SHA256=REPLACE_WITH_64_HEX_DIGITS
SAAS_SUPERADMIN_COOKIE_SECURE=true
SAAS_SUPERADMIN_ALLOWED_ORIGINS=https://fashionstore-web-taupe.vercel.app,https://fashionstore-web-josias-projects-6cccf216.vercel.app
SAAS_RESERVAS_ENABLED=false
SAAS_VENTAS_ENABLED=false
SAAS_OFFLINE_ENABLED=false
# Add existing, reviewed Stripe test keys, webhook secret, CORS, actor owner settings as required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
